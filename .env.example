# ESTARA Pro environment. Copy to .env and fill in. Never commit .env.
# Behaviour lives in client/client.config.yaml; this file only holds infrastructure and secrets.

# --- Runtime -----------------------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
# optional; defaults to client/client.config.yaml
ESTARA_CONFIG_PATH=

# --- Database and Redis ------------------------------------------------------------------
POSTGRES_USER=estara
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=estara
# Host-side URLs (make migrate / make check from your machine). Compose overrides these
# inside containers to point at the db and redis services.
DATABASE_URL=postgresql+psycopg://estara:change-me-local-only@localhost:5432/estara
TEST_DATABASE_URL=postgresql+psycopg://estara:change-me-local-only@localhost:5432/estara_test
# Optional: database for `make eval` (WIPED on every run). Defaults to TEST_DATABASE_URL.
# EVAL_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
# Free cloud demo only (docs/deploy-free.md): run without Redis and without the worker.
REDIS_ENABLED=true
RUN_JOBS_IN_WEB=false
# Public demo only: synthetic homes may load in production, calls are capped. Never for a client.
DEMO_MODE=false
DEMO_MAX_CALL_MINUTES=5

# --- Dashboard sessions ------------------------------------------------------------------
# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_HOURS=12
# set false only for plain-http local development
COOKIE_SECURE=true
DASHBOARD_ORIGIN=http://localhost:3000

# --- Data Center uploads -----------------------------------------------------------------
# Where uploaded files are kept (Compose mounts a volume at /srv/data/uploads).
UPLOAD_DIR=uploads
MAX_UPLOAD_MB_DATA=10
MAX_UPLOAD_MB_DOCUMENT=25
# Folder of sample inventory CSVs loaded by `make seed-sample` (Compose sets this itself).
SAMPLE_INVENTORY_DIR=

# --- Sample users created by `make seed-sample` (local/sample data only) ------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=

# --- LLM providers (Stage 3) -------------------------------------------------------------
# Which provider and model are used comes from client.config.yaml (llm.provider, llm.model).
LLM_TIMEOUT_SECONDS=25
LLM_MAX_ATTEMPTS=3
# HTTP 429 handling for live conversations (keep waits short: a customer is waiting).
LLM_RATE_LIMIT_ATTEMPTS=3
LLM_MAX_RATE_LIMIT_WAIT_SECONDS=10
# Minimum seconds between LLM calls; 0 in production. Also used by `make chat`.
LLM_MIN_INTERVAL_SECONDS=0
# Attempts for a request that timed out (2 = one retry; a slow request has usually used quota).
LLM_TIMEOUT_ATTEMPTS=2
# `make eval` pacing for free tiers (seconds between LLM calls; default 10) and the response
# timeout it uses instead of LLM_TIMEOUT_SECONDS (default 120).
# EVAL_LLM_DELAY_SECONDS=10
# EVAL_LLM_TIMEOUT_SECONDS=120
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Vapi voice (see docs/demo.md) ---------------------------------------------------------
# Private API key (server side only, used by `python -m app.channels.vapi.sync`).
VAPI_API_KEY=
# A long random secret you choose. Put the same value in Vapi as a Bearer credential (server
# URL) and as the Custom LLM API key. python -c "import secrets; print(secrets.token_urlsafe(32))"
VAPI_WEBHOOK_SECRET=
# Public key (safe in the browser) for test calls from the dashboard.
VAPI_PUBLIC_KEY=
# Native mode (default): the ID of the assistant you created in the Vapi dashboard.
# custom_llm mode: printed by the sync command after it creates the assistant.
VAPI_ASSISTANT_ID=
# Optional comparison assistant B (Vapi API Request tools, ADR 0015): printed by
# `python -m app.channels.vapi.api_tools` the first time; put it here so later runs update it.
VAPI_ASSISTANT_ID_B=
# The id of the Bearer credential you created in Vapi (Integrations > Server Configuration).
VAPI_SERVER_CREDENTIAL_ID=
# How Vapi reaches this backend: your free tunnel URL for demos, the client's domain later.
PUBLIC_BASE_URL=

# --- WhatsApp Cloud API (see docs/demo.md, "WhatsApp") -----------------------------------
# From your Meta app: WhatsApp > API Setup (access token, phone number id) and
# App settings > Basic (app secret). The verify token is any string you choose; enter the same
# value in Meta's webhook settings.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v24.0

# --- Production only (docker-compose.prod.yml, see docs/deploy.md) ----------------------
# The client's domain for the dashboard and webhooks, pointed at the server (DNS A record).
# DOMAIN=ai.clientname.in
# Daily backups into ./backups: time in UTC (21:00 UTC = 02:30 in India) and days kept.
# BACKUP_TIME_UTC=21:00
# BACKUP_KEEP_DAYS=14
